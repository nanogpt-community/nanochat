# Postgres connection string.
# With docker-compose this is set for you from POSTGRES_PASSWORD below.
DATABASE_URL=postgres://nanochat:nanochat@localhost:5432/nanochat

# Password for the bundled docker-compose postgres service
POSTGRES_PASSWORD=nanochat

# Better Auth secret for session encryption
BETTER_AUTH_SECRET=

# Better Auth URL (required for production, e.g. https://example.com)
BETTER_AUTH_URL=http://localhost:3432

# Trusted Origins (comma-separated list of URLs)
BETTER_AUTH_TRUSTED_ORIGINS=

# Optional: OIDC single sign-on provider.
# Configure these to show an SSO button on the login page while keeping password/passkey login enabled.
SSO_PROVIDER_ID=
SSO_DOMAIN=
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_LABEL=Single sign-on

# Encryption key for API keys in the database
# Generate a secure random string (at least 32 characters)
# You can generate one with: openssl rand -base64 32
# IMPORTANT: Keep this key secure and never change it, or all encrypted API keys will be lost
ENCRYPTION_KEY=

# Optional: dedicated secret for developer API key lookup hashes.
# If unset or empty, the app falls back to ENCRYPTION_KEY or BETTER_AUTH_SECRET.
# Note: creating developer API keys still requires ENCRYPTION_KEY to be set.
API_KEY_HASH_SECRET=

NANOGPT_API_KEY=
# Optional: override NanoGPT base URL (useful for proxies)
NANOGPT_BASE_URL=https://nano-gpt.com

# Artificial Analysis API key for model benchmarks (optional)
# Get a free key at https://artificialanalysis.ai/
ARTIFICIAL_ANALYSIS_API_KEY=

# Set to "true" to disable new account creation
DISABLE_SIGNUPS=false

# Restrict to subscription models only (when using server API key)
SUBSCRIPTION_MODELS_ONLY=false

# Set daily message limit for users using server API key (0 = unlimited)
DAILY_MESSAGE_LIMIT=0

# Disable web search/web scraping/context memory for users using server API key (only active if SUBSCRIPTION_MODELS_ONLY=true)
DISABLE_WEB_ON_SERVER_KEY_WITH_SUBSCRIPTION_ONLY=false

# Increase body size limit for file uploads (SvelteKit default is 512KB) 50000000=50MB
BODY_SIZE_LIMIT=50000000

# Optional hardening for open-signup deployments. All three have safe defaults
# and can be left unset.
# Per-user upload cap in MB. Default: 2048 when signups are open, unlimited when
# DISABLE_SIGNUPS=true. 0 = unlimited.
#USER_STORAGE_QUOTA_MB=2048
# Refuse uploads that would leave the disk below this many MB. Default 512, 0 = off.
#MIN_FREE_DISK_MB=512
# Whether user-configured MCP servers and Karakeep may point at private/LAN
# addresses. Default: allowed when DISABLE_SIGNUPS=true, blocked when signups are open.
#ALLOW_PRIVATE_INTEGRATIONS=true
