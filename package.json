{
	"name": "nanochat",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "bun --bun ./node_modules/.bin/vite build",
		"preview": "vite preview",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate-from-sqlite": "bun run scripts/migrate-sqlite-to-postgres.ts",
		"db:backfill-api-key-hashes": "bun run scripts/backfill-api-key-hashes.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.543",
		"@playwright/test": "^1.64.1",
		"@shikijs/langs": "^4.5.0",
		"@shikijs/markdown-it": "^4.5.0",
		"@shikijs/themes": "^4.5.0",
		"@sveltejs/adapter-node": "^6",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.6",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"melt": "^0.44.0",
		"mode-watcher": "^1.1.0",
		"neverthrow": "^8.2.0",
		"openai": "^7.34.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"runed": "^0.37.1",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-meta-tags": "^5.0.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6",
		"typescript-eslint": "^8.71.2",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild"
		]
	},
	"overrides": {
		"@modelcontextprotocol/sdk": "^1.25.2",
		"adm-zip": "^0.6.0",
		"es-define-property": "npm:@socketregistry/es-define-property@^1",
		"function-bind": "npm:@socketregistry/function-bind@^1",
		"gopd": "npm:@socketregistry/gopd@^1",
		"has-symbols": "npm:@socketregistry/has-symbols@^1",
		"hasown": "npm:@socketregistry/hasown@^1",
		"indent-string": "npm:@socketregistry/indent-string@^1",
		"object-assign": "npm:@socketregistry/object-assign@^1",
		"safer-buffer": "npm:@socketregistry/safer-buffer@^1",
		"shell-quote": "npm:shell-quote@^1",
		"side-channel": "npm:@socketregistry/side-channel@^1"
	},
	"dependencies": {
		"@better-auth/core": "1.7.10",
		"@better-auth/passkey": "1.7.10",
		"@better-auth/sso": "1.7.10",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/inter-tight": "^5.3.0",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/nunito-sans": "^5.3.0",
		"@fontsource-variable/open-sans": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@nanogpt/mcp": "^1.5.0",
		"@shikijs/engine-javascript": "^4.5.0",
		"@types/node": "^26.6.5",
		"adm-zip": "^0.6.1",
		"better-auth": "1.7.10",
		"cron-parser": "^5.10.2",
		"dotenv": "^18.0.8",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"epub2": "^3.0.2",
		"hastscript": "^9.0.1",
		"htmlparser2": "^12.0.0",
		"markdown-it-async": "^2.2.0",
		"pdf-parse": "^2.4.5",
		"postgres": "^3.4.9",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.7"
	}
}
